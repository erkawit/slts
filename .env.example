# ================================================================
# SLTS v2 — Environment Variables
# ค่าที่มาจาก Neon จะถูกเขียนให้อัตโนมัติด้วย `neon deploy` (ลงไฟล์ .env.local)
# บน Vercel: Project Settings → Environment Variables (ใส่ให้ครบทุกตัวด้านล่าง)
# ================================================================

# --- Neon (อัตโนมัติจาก neon deploy / neon env pull) ---
DATABASE_URL=                 # pooled (-pooler) ใช้กับแอป
DATABASE_URL_UNPOOLED=        # direct ใช้กับ migration / pg_dump
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
# AI_MODEL=gpt-5-mini         # (ไม่บังคับ) เปลี่ยนรุ่นโมเดลที่ใช้อ่านบัญชีจ่ายหมาย

# --- ความปลอดภัย (ต้องตั้งเอง) ---
SESSION_SECRET=               # สุ่มยาว ≥ 32 ตัว เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_INITIAL_PASSWORD=       # ใช้เฉพาะตอนฐานข้อมูลยังว่าง (สร้างผู้ใช้ admin) — ≥ 8 ตัวอักษร

# --- ที่เก็บไฟล์ภาพ ---
# ค่าเริ่มต้น: เก็บภาพใน Neon Postgres (ไม่ต้องใช้ Google Drive / Google Sheet / Apps Script)
# PHOTO_STORAGE=google-drive   # (ไม่บังคับ) ถ้าต้องการกลับไปเก็บภาพใน Google Drive ให้ตั้งค่านี้ + 2 ค่าด้านล่าง
# GAS_DRIVE_URL=
# GAS_BRIDGE_SECRET=

# --- ทดสอบ (ใช้ฐานข้อมูล/branch ทดสอบเท่านั้น ตารางจะถูกลบ!) ---
# TEST_DATABASE_URL=
