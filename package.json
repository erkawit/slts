  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2"
