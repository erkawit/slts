{
  "name": "slts",
  "version": "1.0.0",
  "description": "**สำหรับเจ้าพนักงานศาลจังหวัดอุดรธานี**",
  "main": "index.js",
  "scripts": {
    "build": "node build-public.js",
    "sync-public": "node build-public.js",
    "cap:sync": "node build-public.js && npx cap sync",
    "cap:open": "node build-public.js && npx cap sync && npx cap open android",
    "build:apk": "node build-public.js && npx cap sync && cd android && gradlew.bat assembleDebug",
    "sync:neon": "node scripts/sync-to-neon.js",
    "sync:neon:dry": "node scripts/sync-to-neon.js --dry-run"
  },
