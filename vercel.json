{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/slts.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/photo.js": {
      "maxDuration": 15
    },
    "api/report.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, geolocation=*, accelerometer=*, gyroscope=*, magnetometer=*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
